{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource"
    }
  ],
  "title": "cache-kit 三级缓存",
  "uid": "cache-kit-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "L1 命中率",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "cache_kit_l1_hit_rate",
          "legendFormat": "L1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "L2 命中率",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "cache_kit_l2_hit_rate",
          "legendFormat": "L2",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "binlog 失效传播延迟（含时钟偏差，趋势观测）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "cache_kit_invalidation_delay_seconds{quantile=\"0.5\"}",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "cache_kit_invalidation_delay_seconds{quantile=\"0.99\"}",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "请求与回源速率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(cache_kit_l1_requests_total[5m]))",
          "legendFormat": "L1 {{result}}",
          "refId": "A"
        },
        {
          "expr": "sum by (result) (rate(cache_kit_l2_requests_total[5m]))",
          "legendFormat": "L2 {{result}}",
          "refId": "B"
        },
        {
          "expr": "rate(cache_kit_db_loads_total[5m])",
          "legendFormat": "DB 回源/键",
          "refId": "C"
        },
        {
          "expr": "rate(cache_kit_null_placeholders_total[5m])",
          "legendFormat": "null 占位",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "失效与广播",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "rate(cache_kit_evict_keys_total[5m])",
          "legendFormat": "失效键/s",
          "refId": "A"
        },
        {
          "expr": "rate(cache_kit_broadcast_sent_total[5m])",
          "legendFormat": "广播发送/s",
          "refId": "B"
        },
        {
          "expr": "sum(rate(cache_kit_broadcast_received_total[5m])) by (applied)",
          "legendFormat": "广播接收 applied={{applied}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "失效丢失告警（正常应恒为 0，增长即触发排查）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "increase(cache_kit_evict_retries_exhausted_total[10m])",
          "legendFormat": "DEL 重试耗尽",
          "refId": "A"
        },
        {
          "expr": "increase(cache_kit_doubledelete_skipped_total[10m])",
          "legendFormat": "双删积压跳过",
          "refId": "B"
        },
        {
          "expr": "increase(cache_kit_binlog_position_resets_total[10m])",
          "legendFormat": "binlog 位点重置",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "L2 降级（Redis 不健康信号）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (op) (rate(cache_kit_l2_fallbacks_total[5m]))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "L1 预刷新提交速率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "expr": "sum(rate(cache_kit_l1_refreshahead_triggered_total[5m]))",
          "legendFormat": "提交",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "L1 预刷新丢弃与失败（持续增长需关注）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "expr": "sum(rate(cache_kit_l1_refreshahead_dropped_total[5m]))",
          "legendFormat": "丢弃",
          "refId": "A"
        },
        {
          "expr": "sum(rate(cache_kit_l1_refreshahead_failed_total[5m]))",
          "legendFormat": "失败",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "L2 值策略（超限跳写 / 压缩写入）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "expr": "sum(rate(cache_kit_l2_value_oversized_total[5m]))",
          "legendFormat": "超限跳写（应趋近 0）",
          "refId": "A"
        },
        {
          "expr": "sum(rate(cache_kit_l2_value_compressed_total[5m]))",
          "legendFormat": "压缩写入",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    }
  ]
}